  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-cloudfront": "^3.1172.0"
  },
  "devDependencies": {
    "@toruslabs/oxlint-config-node": "^1.0.0",
    "@toruslabs/torus-scripts": "^9.0.2",
